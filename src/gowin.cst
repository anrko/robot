// ACG138 core board U10 (GW5AT-LV60PG484A), carrier board user I/O.
// Sources: core schematic 25_GW5AT-60K-1 and 26_GW5AT-60K-2,
// carrier schematic and ACG138 user manual V1.11.
// rst_n uses S3 / KeyIN0, not S8 / RECONFIG_N (a configuration pin).
IO_LOC "clk" F13;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rst_n" H4;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// J2 USB_Debug: FPGA CH340E transmit (core B1_T93_P, package C13).
IO_LOC "uart_tx" C13;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "state_led[0]" E13;
IO_LOC "state_led[1]" E14;
IO_LOC "state_led[2]" D14;
IO_LOC "state_led[3]" D15;
IO_LOC "state_led[4]" B17;
IO_LOC "state_led[5]" B18;
IO_LOC "state_led[6]" B15;
IO_LOC "state_led[7]" B16;
IO_PORT "state_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "state_led[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// DDR3L: U15/U16, 32-bit data bus. Physical nets are DDR_A*, DDR_BA*,
// DDR_DQ*, DDR_DM*, DDR_DQS*, DDR_CK*, DDR_CKE0, DDR_CS, DDR_RAS,
// DDR_CAS, DDR_WE, DDR_ODT, DDR_RESET on the core schematic.
IO_LOC "ddr_addr[0]" K4;
IO_LOC "ddr_addr[1]" N2;
IO_LOC "ddr_addr[2]" P5;
IO_LOC "ddr_addr[3]" K3;
IO_LOC "ddr_addr[4]" M3;
IO_LOC "ddr_addr[5]" K6;
IO_LOC "ddr_addr[6]" M1;
IO_LOC "ddr_addr[7]" J4;
IO_LOC "ddr_addr[8]" L1;
IO_LOC "ddr_addr[9]" P4;
IO_LOC "ddr_addr[10]" P2;
IO_LOC "ddr_addr[11]" M2;
IO_LOC "ddr_addr[12]" P1;
IO_LOC "ddr_addr[13]" N4;
// DDR IP emits A[13:0] for the x16 16K-row geometry. Drive the board's
// additional A14 pin low (reserved for this geometry) instead of leaving it floating.
IO_LOC "ddr_addr[14]" L3;
IO_PORT "ddr_addr[14]" IO_TYPE=SSTL135_I PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.35;
IO_LOC "ddr_bank[0]" L6;
IO_LOC "ddr_bank[1]" N3;
IO_LOC "ddr_bank[2]" N5;
IO_LOC "ddr_cs" L4;
IO_LOC "ddr_ras" M6;
IO_LOC "ddr_cas" M5;
IO_LOC "ddr_we" P6;
IO_LOC "ddr_ck" V7;
IO_LOC "ddr_ck_n" W7;
IO_LOC "ddr_cke" R1;
IO_LOC "ddr_odt" L5;
IO_LOC "ddr_reset_n" J6;

IO_LOC "ddr_dm[0]" R6;
IO_LOC "ddr_dm[1]" AB6;
IO_LOC "ddr_dm[2]" AA5;
IO_LOC "ddr_dm[3]" Y1;
IO_LOC "ddr_dq[0]" T4;
IO_LOC "ddr_dq[1]" AA6;
IO_LOC "ddr_dq[2]" T5;
IO_LOC "ddr_dq[3]" Y6;
IO_LOC "ddr_dq[4]" U5;
IO_LOC "ddr_dq[5]" T6;
IO_LOC "ddr_dq[6]" U6;
IO_LOC "ddr_dq[7]" V5;
IO_LOC "ddr_dq[8]" Y7;
IO_LOC "ddr_dq[9]" AB8;
IO_LOC "ddr_dq[10]" Y8;
IO_LOC "ddr_dq[11]" AB7;
IO_LOC "ddr_dq[12]" Y9;
IO_LOC "ddr_dq[13]" AA8;
IO_LOC "ddr_dq[14]" W9;
IO_LOC "ddr_dq[15]" V10;
IO_LOC "ddr_dq[16]" AA1;
IO_LOC "ddr_dq[17]" Y4;
IO_LOC "ddr_dq[18]" AB3;
IO_LOC "ddr_dq[19]" W4;
IO_LOC "ddr_dq[20]" AB1;
IO_LOC "ddr_dq[21]" AB5;
IO_LOC "ddr_dq[22]" AB2;
IO_LOC "ddr_dq[23]" AA4;
IO_LOC "ddr_dq[24]" Y2;
IO_LOC "ddr_dq[25]" W2;
IO_LOC "ddr_dq[26]" V2;
IO_LOC "ddr_dq[27]" T1;
IO_LOC "ddr_dq[28]" V3;
IO_LOC "ddr_dq[29]" U1;
IO_LOC "ddr_dq[30]" U2;
IO_LOC "ddr_dq[31]" W1;
IO_LOC "ddr_dqs[0]" W6;
IO_LOC "ddr_dqs_n[0]" W5;
IO_LOC "ddr_dqs[1]" V9;
IO_LOC "ddr_dqs_n[1]" V8;
IO_LOC "ddr_dqs[2]" Y3;
IO_LOC "ddr_dqs_n[2]" AA3;
IO_LOC "ddr_dqs[3]" R3;
IO_LOC "ddr_dqs_n[3]" R2;

// GW5AT-60 uses SSTL135_I and SSTL135D_I (DS981 Table 2-5), not SSTL135.
// DDR banks are wired to 1.35 V on the ACG138 core board. Never use 1.5/2.5 V.
IO_PORT "ddr_addr[0]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[1]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[2]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[3]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[4]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[5]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[6]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[7]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[8]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[9]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[10]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[11]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[12]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_addr[13]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_bank[0]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_bank[1]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_bank[2]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_cs" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_ras" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_cas" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_we" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_cke" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_odt" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_reset_n" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dm[0]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dm[1]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dm[2]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dm[3]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dq[0]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dq[1]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
IO_PORT "ddr_dq[2]" IO_TYPE=SSTL135_I PULL_MODE=NONE BANK_VCCIO=1.35;
